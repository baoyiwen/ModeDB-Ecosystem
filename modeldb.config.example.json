{
  "port": 9090,
  "host": "127.0.0.1",
  "advertisedHost": "",
  "publicBaseUrl": "",
  "logDir": "logs",
  "workspace": "vault",
  "bufferThreshold": 50000,
  "cacheSize": "2GB",
  "mode": "development",
  "designerWorkspace": "model_designer_workspace",
  "security": {
    "version": 1,
    "audit": {
      "retentionDays": 365,
      "maxEvents": 10000
    },
    "network": {
      "transport": {
        "mode": "loopback"
      }
    }
  },
  "autoBackup": {
    "enabled": false,
    "intervalMinutes": 60,
    "runOnStart": false,
    "reason": "auto",
    "databases": []
  },
  "dev": false
}
