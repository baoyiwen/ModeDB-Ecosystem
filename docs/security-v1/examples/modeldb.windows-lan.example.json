{
  "host": "0.0.0.0",
  "port": 9443,
  "advertisedHost": "192.168.1.10",
  "publicBaseUrl": "https://192.168.1.10:9443",
  "workspace": "vault",
  "logDir": "logs",
  "bufferThreshold": 100,
  "cacheSize": "1GB",
  "mode": "production",
  "dev": false,
  "designerWorkspace": "model_designer_workspace",
  "security": {
    "version": 1,
    "network": {
      "transport": {
        "mode": "tls",
        "certificateFile": "certs/server.crt",
        "privateKeyFile": "certs/server.key"
      },
      "allowedOrigins": ["https://192.168.1.10:5175"],
      "data": {
        "allowListEnabled": true,
        "allow": [
          { "id": "local-v4", "source": "127.0.0.1/32" },
          { "id": "local-v6", "source": "::1/128" },
          { "id": "server-a", "source": "192.168.1.10/32" },
          { "id": "designer-b", "source": "192.168.1.20/32" }
        ],
        "deny": []
      },
      "management": {
        "allowListEnabled": true,
        "allow": [
          { "id": "local-v4", "source": "127.0.0.1/32" },
          { "id": "local-v6", "source": "::1/128" },
          { "id": "server-a", "source": "192.168.1.10/32" },
          { "id": "designer-b", "source": "192.168.1.20/32" }
        ],
        "deny": []
      }
    },
    "audit": {
      "retentionDays": 365,
      "maxEvents": 10000
    }
  },
  "autoBackup": {
    "enabled": false,
    "intervalMs": 3600000,
    "runOnStart": false,
    "reason": "scheduled",
    "databases": ["business"]
  }
}
