{
  "compilerOptions": {
    "paths": {
      "@mode-db/core": ["./packages/core/index.ts"],
      "@mode-db/common": ["./packages/common/src/index.ts"],
      "@mode-db/shared": ["./packages/shared/src/index.ts"],
      "@mode-db/sdk": ["./packages/sdk/src/index.ts"]
    },
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["test/**/*", "scripts/**/*.ts", "scripts/**/*.mjs", "packages/core/**/*.ts"],
  "exclude": ["node_modules", "dist", "data", "packages/core/dist", "packages/**/dist"]
}
