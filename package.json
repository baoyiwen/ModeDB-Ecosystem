{
  "name": "modedb-ecosystem",
  "private": true,
  "version": "0.0.0",
  "description": "ModeDB-Ecosystem — pnpm monorepo orchestration root; engine in packages/core (@mode-db/core), server, SDK, shared, common",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "modeldb-server": "./packages/server/dist/cli.js"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "pnpm run build:shared && pnpm run build:common && pnpm run build:core && pnpm run build:server && pnpm run build:sdk && node scripts/obfuscate-dist.mjs",
    "obfuscate:dist": "node scripts/obfuscate-dist.mjs",
    "build:core": "pnpm --filter @mode-db/core run build",
    "build:lib": "pnpm run build:core",
    "build:common": "pnpm --filter @mode-db/common run build",
    "build:shared": "pnpm --filter @mode-db/shared run build",
    "build:server": "pnpm --filter @mode-db/server run build",
    "build:sdk": "pnpm --filter @mode-db/sdk run build",
    "build:web": "pnpm --filter modedb-web-playground run build",
    "chunnel:clean": "tsx scripts/chunnel-cleaner.ts",
    "start:server": "pnpm run build:server && node ./packages/server/dist/cli.js",
    "dev": "pnpm --filter @mode-db/core run dev",
    "dev:web": "pnpm --filter modedb-web-playground dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,mjs,json,md}\"",
    "typecheck": "pnpm run build:shared && pnpm run build:common && pnpm run build:core && pnpm run build:server && tsc --noEmit -p tsconfig.json",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "tsx --test test/unit/field-defs.test.ts",
    "test:integration": "pnpm run build:shared && pnpm run build:common && pnpm run build:core && pnpm run build:server && pnpm run build:sdk && tsx test/integration/e2e-engine-workflow.ts",
    "prepare": "husky",
    "check:sources": "node scripts/assert-no-build-artifacts-in-src.mjs && node scripts/assert-sdk-client-only.mjs",
    "check": "pnpm run check:sources && pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "publish:npm": "node scripts/publish-workspaces.mjs",
    "publish:npm:go": "node scripts/publish-workspaces.mjs --live --yes",
    "publish:workspaces": "node scripts/publish-workspaces.mjs",
    "publish:workspaces:live": "node scripts/publish-workspaces.mjs --live --yes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baoyiwen/ModeDB-Ecosystem.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/baoyiwen/ModeDB-Ecosystem/issues"
  },
  "homepage": "https://github.com/baoyiwen/ModeDB-Ecosystem#readme",
  "devDependencies": {
    "@mode-db/core": "workspace:*",
    "@mode-db/sdk": "workspace:*",
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "terser": "^5.39.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
