{
  // 本文件是“带注释的参考模板”（JSONC），便于逐项理解配置。
  // modeldb-server 实际读取的是严格 JSON：复制为 modeldb.config.json 前请删除注释，
  // 或直接使用仓库中的 modeldb.config.example.json 作为合法 JSON 起点。
  // 同一个参数的生效优先级为：CLI 参数 → 本文件字段 → 环境变量 → 默认值。

  // 服务监听端口。外部访问时，防火墙、反向代理和客户端地址都必须使用同一个端口。
  // CLI：-p / --port；环境变量：MODEL_DB_PORT；默认值：9090。
  "port": 9091,

  // 实际绑定的网卡地址：
  // 127.0.0.1 = 仅本机访问；0.0.0.0 = 监听所有 IPv4 网卡；生产环境也可以填指定网卡 IP。
  // CLI：-H / --host；环境变量：MODEL_DB_HOST；默认值：127.0.0.1。
  "host": "0.0.0.0",

  // 启动日志中优先展示的客户端主机名或 IP。它只影响提示文字，不改变监听行为。
  // 例如局域网访问填写服务器 IP；公网反向代理场景可填写 api.example.com。
  // CLI：--advertised-host；环境变量：MODEL_DB_ADVERTISED_HOST；省略时由服务自动推断。
  "advertisedHost": "",

  // 提供给接口调用方和 Query Designer 展示的公开 HTTP(S) 基础地址。
  // 不要写具体接口路径；服务会自动拼接 /api/v1/databases/{db}/query-interfaces/{name}。
  // 通过反向代理使用域名时填写 https://api.example.com；局域网可填写 http://192.168.1.20:9091。
  // 留空时：若 host 是 0.0.0.0/::，系统会从启动时列出的非回环网卡中自动选择一个地址；
  // 若 host 是 127.0.0.1，则不生成可供其它机器访问的公开地址。
  // CLI：--public-base-url；环境变量：MODEL_DB_PUBLIC_BASE_URL。
  // 必须是绝对 http(s) URL，不能带用户名、密码、查询参数或 fragment；末尾斜杠会自动去掉。
  "publicBaseUrl": "",

  // 服务日志目录。相对路径相对于本配置文件所在目录；绝对路径也可以使用。
  // 日志文件包括 system.log；production 模式或 MODEL_DB_ACCESS_LOG=true 时还会写 access.log。
  // 省略时默认使用“配置文件所在目录/logs”。此字段没有 CLI 覆盖参数。
  "logDir": "logs",

  // 逻辑库根目录。每个业务库位于 vault/{数据库名}/atlas.mld。
  // storageRoot 和 dbPath 是兼容旧配置的别名，三者只应配置一个。
  // 相对路径相对于本配置文件所在目录；生产建议使用绝对路径，避免切换工作目录导致数据落盘位置改变。
  "workspace": "vault",
  // 兼容写法（不要与 workspace 同时配置）：
  // "storageRoot": "D:/opt/modeldb/vault",
  // "dbPath": "D:/opt/modeldb/vault/Asset_Graph/atlas.mld",
  // dbPath 指向 .mld 文件时，父目录作为逻辑库根，文件名（去掉 .mld）作为默认逻辑库名。

  // 写缓冲达到该行数时刷新到磁盘。数值越大吞吐更高，但进程异常时未刷新的数据更多。
  // CLI：当前启动命令未提供独立选项；环境变量：MODEL_DB_BUFFER_THRESHOLD。
  // 必须是正数；省略或非法值表示使用引擎默认值。
  "bufferThreshold": 50000,

  // 预留的缓存容量提示。目前不作为硬性内存限制，也不会自动创建业务缓存文件。
  // 该字段用于说明部署预期，不等于 cache/ 目录的实际大小限制。
  "cacheSize": "2GB",

  // development 或 production。production 会启用访问日志（HTTP / 查询 / 写入链路）。
  // 也可通过环境变量 MODEL_DB_ACCESS_LOG=true 单独启用 access.log；默认不启用。
  "mode": "production",

  // 保存 Query Designer 的 sys_* 元数据、接口注册表、发布台账和审计记录的逻辑库。
  // 该逻辑库必须位于 workspace 下，并且需要与 Model Designer 使用的数据库名一致。
  // 环境变量：MODEL_DB_DESIGNER_WORKSPACE（仅在文件没有填写时生效）。
  "designerWorkspace": "model_designer_workspace",

  // 服务认证令牌。必须与 SDK、管理 API 和 HTTP 直连请求中的 token 完全一致。
  // 请使用长随机字符串，禁止提交真实生产令牌到 Git。
  // CLI：-t / --token；环境变量：MODEL_DB_CONNECT_TOKEN；三者优先级为 CLI → 文件 → 环境变量。
  "connectToken": "replace-with-long-random-secret",

  // 是否允许开发诊断输出。生产环境必须保持 false，避免输出敏感的 RPC 诊断信息。
  // CLI：--dev；环境变量：MODEL_DB_DEV（true/false、1/0、yes/no）。
  "dev": false,

  // 自动备份。enabled=false 或删除整个对象都表示关闭自动备份。
  "autoBackup": {
    // 是否启用定时备份。
    "enabled": false,
    // 两种间隔写法二选一；intervalMs 优先于 intervalMinutes，最小值为 60000ms。
    "intervalMinutes": 60,
    // "intervalMs": 3600000,
    // 服务启动后是否立即执行一次备份。
    "runOnStart": false,
    // 自动备份文件名中的原因标记，只允许字母、数字、点、下划线和短横线。
    "reason": "auto",
    // 只备份列出的数据库；空数组或省略表示备份 workspace 下全部逻辑库。
    "databases": [],
  },

  // 下面是“只通过环境变量或 CLI 提供”的覆盖项速查，不要把它们添加为 JSON 字段：
  // MODEL_DB_PORT / -p <number>                 监听端口
  // MODEL_DB_HOST / -H <host>                   监听地址
  // MODEL_DB_ADVERTISED_HOST / --advertised-host <host>  启动信息中的客户端地址
  // MODEL_DB_PUBLIC_BASE_URL / --public-base-url <url>    Query Interface 公共地址
  // MODEL_DB_CONNECT_TOKEN / -t <secret>        连接认证令牌
  // MODEL_DB_BUFFER_THRESHOLD <rows>            写缓冲行数
  // MODEL_DB_DESIGNER_WORKSPACE <name>          Designer 元数据逻辑库
  // MODEL_DB_ACCESS_LOG=true                    强制启用 access.log
  // MODEL_DB_DEV=true                           开发诊断输出
  // -c / --config <session-root|config-file>    选择会话根或配置文件
}
