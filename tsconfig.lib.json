{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "src/**/*",
    "common/**/*",
    "authoring/**/*",
    "runtime/**/*",
    "templates/**/*"
  ],
  "exclude": ["node_modules", "dist", "data", "test/**/*", "packages/**/*"]
}
