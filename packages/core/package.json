{
  "name": "@mode-db/core",
  "version": "1.0.1",
  "description": "ModeDB storage engine, authoring/runtime model APIs, and single-file Vault orchestration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baoyiwen/ModeDB-Ecosystem.git",
    "directory": "packages/core"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@mode-db/common": "workspace:*",
    "@mode-db/shared": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
