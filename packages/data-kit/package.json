{
  "name": "@mode-db/data-kit",
  "version": "0.0.3",
  "description": "Headless data page kit: global view/edit/delete modes, batch DataBinding, ViewDataShape adapters, and ingest/import protocols for ModelDB data UI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mode-db/common": "workspace:*",
    "@mode-db/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  }
}
