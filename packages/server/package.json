{
  "name": "@mode-db/server",
  "version": "0.1.0",
  "description": "ModelDB WebSocket server — CLI, config loading, wire transport, and query dispatch.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "modeldb-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mode-db/shared": "file:../shared",
    "@fastify/websocket": "^11.2.0",
    "commander": "^12.1.0",
    "fastify": "^5.8.4",
    "mode-db-engine": "file:../..",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  },
  "license": "ISC"
}
