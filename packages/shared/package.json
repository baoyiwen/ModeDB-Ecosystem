{
  "name": "@mode-db/shared",
  "version": "0.1.0",
  "description": "Shared wire obfuscation, diagnostics, and shadow codec re-exports for ModelDB clients.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "mode-db-engine": ">=1.0.0"
  },
  "dependencies": {
    "mode-db-engine": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "license": "ISC"
}
