{
  "name": "@mode-db/sdk",
  "version": "0.1.0",
  "description": "Remote WebSocket client for ModeDB-Ecosystem / ModelDB — same QueryChain fluent API, wire-obfuscated payloads.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mode-db/shared": "workspace:*"
  },
  "optionalDependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  }
}
